{
  "info":{"name":"StockFlow API acceptance","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[{"key":"baseUrl","value":"http://localhost:8000/api"},{"key":"token","value":""},{"key":"customerId","value":""},{"key":"productId","value":""},{"key":"orderId","value":""},{"key":"itemId","value":""},{"key":"suffix","value":""}],
  "item":[
    {"name":"01 Health","request":{"method":"GET","url":"{{baseUrl}}/health"},"event":[{"listen":"test","script":{"exec":["pm.test('health returns 200',()=>pm.response.to.have.status(200));","pm.collectionVariables.set('suffix',Date.now().toString());"]}}]},
    {"name":"02 Admin login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/x-www-form-urlencoded"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"username","value":"admin"},{"key":"password","value":"Admin123!"}]},"url":"{{baseUrl}}/token"},"event":[{"listen":"test","script":{"exec":["pm.test('admin login succeeds',()=>pm.response.to.have.status(200));","pm.collectionVariables.set('token',pm.response.json().access_token);"]}}]},
    {"name":"03 Create customer","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Postman Customer {{suffix}}\",\"email\":\"postman{{suffix}}@example.test\"}"},"url":"{{baseUrl}}/customers"},"event":[{"listen":"test","script":{"exec":["pm.test('customer created',()=>pm.response.to.have.status(201));","pm.collectionVariables.set('customerId',pm.response.json().id);"]}}]},
    {"name":"04 Read customer search","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/customers?q=Postman%20Customer"},"event":[{"listen":"test","script":{"exec":["pm.test('search works',()=>pm.response.to.have.status(200));","pm.test('search is an array',()=>pm.expect(pm.response.json()).to.be.an('array'));"]}}]},
    {"name":"05 Update customer","request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Updated Customer {{suffix}}\",\"email\":\"updated{{suffix}}@example.test\"}"},"url":"{{baseUrl}}/customers/{{customerId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('customer updated',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"06 Create product","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Postman Widget {{suffix}}\",\"sku\":\"PM{{suffix}}\",\"price\":12.5,\"stock\":5}"},"url":"{{baseUrl}}/products"},"event":[{"listen":"test","script":{"exec":["pm.test('product created',()=>pm.response.to.have.status(201));","pm.collectionVariables.set('productId',pm.response.json().id);"]}}]},
    {"name":"07 Create order + linked item","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"customer_id\":{{customerId}},\"items\":[{\"product_id\":{{productId}},\"quantity\":2}]}"},"url":"{{baseUrl}}/orders"},"event":[{"listen":"test","script":{"exec":["pm.test('draft order created',()=>pm.response.to.have.status(201));","pm.collectionVariables.set('orderId',pm.response.json().id);"]}}]},
    {"name":"08 Read order and relationship","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/orders/{{orderId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('order includes customer and item',()=>{pm.response.to.have.status(200);let j=pm.response.json();pm.expect(j.customer_id).equal(Number(pm.collectionVariables.get('customerId')));pm.expect(j.items.length).equal(1);pm.expect(j.items[0].quantity).equal(2)});"]}}]},
    {"name":"09 Reject illegal status skip","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"status\":\"closed\"}"},"url":"{{baseUrl}}/orders/{{orderId}}/status"},"event":[{"listen":"test","script":{"exec":["pm.test('draft cannot skip validation',()=>pm.response.to.have.status(409));"]}}]},
    {"name":"10 Validate order stock","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"status\":\"validated\"}"},"url":"{{baseUrl}}/orders/{{orderId}}/status"},"event":[{"listen":"test","script":{"exec":["pm.test('order validated',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"11 Close order","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"status\":\"closed\"}"},"url":"{{baseUrl}}/orders/{{orderId}}/status"},"event":[{"listen":"test","script":{"exec":["pm.test('order closed',()=>pm.response.to.have.status(200));"]}}]},
    {"name":"12 Dashboard aggregates","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/dashboard"},"event":[{"listen":"test","script":{"exec":["pm.test('dashboard returns KPI values',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json()).to.have.property('revenue')});"]}}]},
    {"name":"13 Audit records actor and action","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/audit"},"event":[{"listen":"test","script":{"exec":["pm.test('audit includes recorded action',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().some(x=>x.actor==='admin')).equal(true)});"]}}]},
    {"name":"14 Viewer role denial","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/x-www-form-urlencoded"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"username","value":"viewer"},{"key":"password","value":"View123!"}]},"url":"{{baseUrl}}/token"},"event":[{"listen":"test","script":{"exec":["pm.test('viewer authenticates',()=>pm.response.to.have.status(200));","pm.collectionVariables.set('viewerToken',pm.response.json().access_token);"]}}]},
    {"name":"15 Viewer cannot access audit","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{viewerToken}}"}],"url":"{{baseUrl}}/audit"},"event":[{"listen":"test","script":{"exec":["pm.test('audit is admin-only',()=>pm.response.to.have.status(403));"]}}]},
    {"name":"16 Delete draft item demonstration via direct item endpoint","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/orders/{{orderId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('read remains available after close',()=>pm.response.to.have.status(200));"]}}]}
  ]
}
